# .env — values for the devcontainer build/runtime.
#
# This file is inert today: nothing in this repo reads it yet. It becomes
# load-bearing in a later phase, when Docker Compose reads it natively
# (Compose auto-loads a .env file next to docker-compose.yml) instead of
# these values being hardcoded as build args in devcontainer.json.
#
# Values below are copied from .devcontainer/devcontainer.json's build args.
# RAILS_VERSION is not set in devcontainer.json's build args; its value here
# is the Dockerfile's own ARG default (.devcontainer/Dockerfile line 7),
# which is what actually takes effect today since nothing overrides it.
POSTGRES_VERSION=15
DATABASE_USERNAME=dbuser
DATABASE_PASSWORD=password
RAILS_VERSION=7.2.2
